# Add an API key to enable real, server-side grounded AI analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Change these demo account passwords before exposing the app to other people.
DEMO_CREATOR_PASSWORD=creator-demo
DEMO_REVIEWER_PASSWORD=reviewer-demo
DEMO_ADMIN_PASSWORD=admin-demo
SESSION_SECRET=replace-this-with-a-long-random-secret
PORT=3000
